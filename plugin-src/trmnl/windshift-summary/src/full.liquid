{%- if fault != '' -%}
{% render 'notice', headline: 'Windshift', detail: fault %}
{%- else -%}
<div class="layout layout--col gap--small">

  <div class="grid grid--cols-4">
    {% render 'stat', number: open_total,      caption: 'Open',         size: 'large' %}
    {% render 'stat', number: due_today_count, caption: 'Due today',    size: 'large' %}
    {% render 'stat', number: overdue_count,   caption: 'Overdue',      size: 'large' %}
    {% render 'stat', number: closed_today,    caption: 'Closed today', size: 'large' %}
  </div>

  <div class="columns" style="flex: 1 1 auto; align-items: stretch">
    <div class="column" style="justify-content: flex-start">
      <span class="label label--underline">Next up</span>
      {%- if next_up -%}
        <div class="item">
          <div class="content">
            <span class="title title--small" data-clamp="2">{{ next_up.title }}</span>
            <div class="flex gap--small">
              <span class="label label--small">{{ next_up.key }}</span>
              <span class="label label--small">{{ next_up.status_name }}</span>
              {%- if next_up.due_date %}<span class="label label--small label--underline">Due {{ next_up.due_date | date: '%b %-d' }}</span>{% endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
      {%- if next_milestone -%}
        <div class="item">
          <div class="content">
            <span class="title title--small" data-clamp="2">{{ next_milestone.name }}</span>
            <div class="flex gap--small">
              <span class="label label--small">Milestone</span>
              <span class="label label--small">{{ next_milestone.status | replace: '-', ' ' | capitalize }}</span>
              {%- if next_milestone.target_date %}<span class="label label--small label--underline">Target {{ next_milestone.target_date | date: '%b %-d' }}</span>{% endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
      {%- if next_up == blank and next_milestone == blank -%}
        <span class="description">Nothing open</span>
      {%- endif -%}
    </div>

    <div class="column" style="justify-content: flex-start">
      <span class="label label--underline">Moved today ({{ activity_total }})</span>
      <div data-overflow="true" data-overflow-counter="true" style="flex: 1 1 auto; min-height: 0; overflow: hidden">
        {%- for item in activity -%}
          <div class="item">
            <div class="content">
              <span class="title title--small" data-clamp="1">{{ item.title }}</span>
              <span class="description">{{ item.key }} &nbsp;·&nbsp; {{ item.status_name }} &nbsp;·&nbsp; {{ item.updated_at | date: '%H:%M' }}</span>
            </div>
          </div>
        {%- else -%}
          <span class="description">Quiet so far</span>
        {%- endfor -%}
      </div>
    </div>
  </div>

</div>
{%- endif -%}

<div class="title_bar">
  <span class="title">Windshift</span>
  {%- if fault == '' -%}<span class="instance">{{ owner_name }} &nbsp;·&nbsp; {{ 'now' | date: '%A, %-d %B' }}</span>{%- endif -%}
</div>
